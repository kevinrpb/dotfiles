#!/usr/bin/env zsh

if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}Installing %F{33}ZDHARMA-CONTINUUM%F{220} Initiative Plugin Manager (%F{33}zdharma-continuum/zinit%F{220})…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33} %F{34}Installation successful.%f%b" || \
        print -P "%F{160} The clone has failed.%f%b"
fi

source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# Load a few important annexes, without Turbo
# (this is currently required for annexes)
zinit light-mode for \
    zdharma-continuum/zinit-annex-as-monitor \
    zdharma-continuum/zinit-annex-bin-gem-node \
    zdharma-continuum/zinit-annex-patch-dl \
    zdharma-continuum/zinit-annex-rust

# ----- Addons -----

# rust
zinit id-as"rust" wait=1 as=null sbin="bin/*" lucid rustup \
  atload="[[ ! -f ${ZINIT[COMPLETIONS_DIR]}/_cargo ]] && zi creinstall -q rust; \
  export CARGO_HOME=\$PWD; export RUSTUP_HOME=\$PWD/rustup" for \
  zdharma-continuum/null

export PATH=$PATH:$CARGO_HOME/bin/

# prompt
zinit wait lucid as'program' id-as'starship' \
  has'cargo' \
  atclone'cargo install starship --locked' \
  light-mode for \
  zdharma-continuum/null

# tuckr
zinit wait lucid as'program' id-as'tuckr' \
  has'cargo' \
  atclone'cargo install tuckr' \
  light-mode for \
  zdharma-continuum/null

# Autosuggestions
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
zinit wait lucid atload'_zsh_autosuggest_start' light-mode for \
  zsh-users/zsh-autosuggestions

# zoxide+deps
zinit ice wait"0b" lucid from="gh-r" as="program" \
  pick="zoxide-*/zoxide -> zoxide" \
  cp="zoxide-*/completions/_zoxide -> _zoxide" \
  atclone="./zoxide init zsh > init.zsh" \
  atpull="%atclone" \
  src="init.zsh"
zinit light ajeetdsouza/zoxide

zinit ice from="gh-r" as="command"
zinit light junegunn/fzf

# Completions
zinit ice wait="0c" lucid blockf light-mode for \
  zsh-users/zsh-completions

# Syntax highlight
zinit ice wait="0c" lucid atinit="zpcompinit;zpcdreplay" light-mode for \
  zdharma-continuum/fast-syntax-highlighting

# atuin
zinit ice as"command" from"gh-r" bpick"atuin-*.tar.gz" mv"atuin*/atuin -> atuin" \
  atclone"./atuin init zsh --disable-up-arrow > init.zsh; ./atuin gen-completions --shell zsh > _atuin" \
  atpull"%atclone" src"init.zsh"
zinit light atuinsh/atuin

# eza
zinit ice wait="2" lucid from="gh-r" as="program"
zinit light eza-community/eza

# bat+extras
zinit ice from="gh-r" as="program" pick="usr/bin/bat" bpick="*amd64.deb" atload="alias cat=bat"
zinit light sharkdp/bat

zinit ice lucid wait="1" as="program" pick="src/batgrep.sh"
zinit ice lucid wait="1" as="program" pick="src/batdiff.sh"
zinit light eth-p/bat-extras
alias brg=batgrep.sh
alias bdiff=batdiff.sh
alias man=batman.sh

# bd
zinit ice wait="0b" lucid blockf light-mode for \
  Tarrasch/zsh-bd

# wd
zinit ice wait="0b" lucid blockf light-mode for \
  mfaerevaag/wd

# ----- setup -----

# delete duplicate first
setopt hist_expire_dups_first
