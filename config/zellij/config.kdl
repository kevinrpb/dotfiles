keybinds {
    // Cmd+K in iTerm sends Ctrl+L (\x0c). zellij's Clear wipes the scrollback
    // but does not reprint (bug #4293), so forward Ctrl+L to the shell whose
    // clear-screen widget redraws the prompt (reset-prompt only, no re-clear).
    shared {
        bind "Ctrl l" { Clear; Write 12; }
    }
}

load_plugins {
    zellij:link
}

web_client {
    font "monospace"
}

theme "catppuccin-frappe"
pane_frames false

default_mode "locked"
default_layout "default"

session_serialization true

show_startup_tips false
